<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Maui.AutoNav.Sample.ViewModels"
             x:Class="Maui.AutoNav.Sample.Views.AddContactPage"
             x:DataType="viewmodels:AddContactViewModel"
             Title="Add contact">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Name" FontAttributes="Bold" />
        <Entry Text="{Binding Name}" />

        <Label Text="Email" FontAttributes="Bold" />
        <Entry Text="{Binding Email}" Keyboard="Email" />

        <Label Text="Phone" FontAttributes="Bold" />
        <Entry Text="{Binding Phone}" Keyboard="Telephone" />

        <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,24,0,0" />
        <Button Text="Cancel" Command="{Binding CancelCommand}" />
    </VerticalStackLayout>
</ContentPage>
