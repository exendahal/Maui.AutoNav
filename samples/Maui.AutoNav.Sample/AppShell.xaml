<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Maui.AutoNav.Sample.Views"
       x:Class="Maui.AutoNav.Sample.AppShell"
       Title="Maui.AutoNav Sample">

    <!--
        ContentTemplate builds ContactsPage with a parameterless constructor, so it has no
        BindingContext yet - AmbientNavigationObserver (attached in App.CreateWindow via
        Window.UseAutoNavigation) picks it up via Shell.CurrentPage/Navigated and resolves its
        view model from the same convention map AddAutoNavigation already built.
    -->
    <ShellContent Title="Contacts" ContentTemplate="{DataTemplate views:ContactsPage}" />

</Shell>
